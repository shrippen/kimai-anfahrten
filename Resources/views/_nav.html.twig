{# Sub navigation of the mileage pages. Params: target_user, active #}
{% set nav_params = {user: target_user.id} %}
<ul class="nav nav-tabs mb-3">
    {% for item in [
        {route: 'mileage_trips', key: 'trips', label: 'menu.mileage', icon: 'fas fa-car'},
        {route: 'mileage_suggestions', key: 'suggestions', label: 'suggestion.list', icon: 'fas fa-satellite-dish'},
        {route: 'mileage_vehicles', key: 'vehicles', label: 'vehicle.list', icon: 'fas fa-car-side'},
        {route: 'mileage_rentals', key: 'rentals', label: 'rental.list', icon: 'fas fa-key'},
        {route: 'mileage_places', key: 'places', label: 'place.list', icon: 'fas fa-location-dot'},
        {route: 'mileage_months', key: 'months', label: 'logbook.months', icon: 'fas fa-lock'},
        {route: 'mileage_history', key: 'history', label: 'logbook.history', icon: 'fas fa-clock-rotate-left'},
        {route: 'mileage_overview', key: 'overview', label: 'overview.title', icon: 'fas fa-users'},
        {route: 'mileage_tax_report', key: 'tax', label: 'menu.mileage_tax', icon: 'fas fa-file-invoice'},
    ]|merge(is_granted('approve_mileage') or is_granted('approve_other_mileage') or is_granted('view_other_mileage') or is_granted('view_team_mileage') ? [{route: 'mileage_team', key: 'team', label: 'approval.team', icon: 'fas fa-people-group'}] : []) %}
        <li class="nav-item">
            <a class="nav-link {{ active == item.key ? 'active' : '' }}" href="{{ path(item.route, nav_params) }}"><i class="{{ item.icon }} me-1"></i>{{ item.label|trans }}</a>
        </li>
    {% endfor %}
</ul>
