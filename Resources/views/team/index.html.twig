{% extends 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% import 'macros/datatables.html.twig' as tables %}
{% import 'macros/widgets.html.twig' as widgets %}
{% from '@theme/components/alert.html.twig' import alert %}

{% set bulk_form = 'mileage-team-bulk' %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line(['mileage.approval.team_help'|trans]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    {{ kit.period_nav(['month'], 'month', period.label, period.prev, period.next, period.today, {}) }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% if not approval_enabled %}
        {{ alert({type: 'info', description: 'mileage.approval.disabled_hint'|trans, icon: 'info', dismissible: false, important: false}) }}
    {% endif %}

    {{ kit.kpi_bar([
        {label: 'mileage.approval.pending'|trans, value: totals.submitted|amount, highlight: true},
        {label: 'mileage.approval.status.approved'|trans, value: totals.approved|amount},
        {label: 'mileage.logbook.km.business'|trans, value: mileage.km(totals.business, 0)},
        {label: 'mileage.approval.amount'|trans, value: totals.amount|money('EUR')},
    ]) }}

    {% if rows is empty %}
        {{ kit.empty_state('mileage.approval.no_members'|trans) }}
    {% else %}
        {% set columns = (bulk ? {'select': {class: 'alwaysVisible multiCheckbox w-min', title: false, html_after: kit.bulk_select_all(bulk_form)}} : {})|merge({
            'user': {class: 'alwaysVisible', title: 'mileage.approval.user'},
            'trips': {class: 'd-none d-sm-table-cell text-end w-min', title: 'mileage.tax.trips'},
            'business': {class: 'd-none d-md-table-cell text-end w-min text-nowrap', title: 'mileage.logbook.km.business'},
            'commute': {class: 'd-none d-lg-table-cell text-end w-min text-nowrap', title: 'mileage.logbook.km.commute'},
            'private': {class: 'd-none d-lg-table-cell text-end w-min text-nowrap', title: 'mileage.logbook.km.private'},
            'amount': {class: 'd-none d-sm-table-cell text-end w-min text-nowrap', title: 'mileage.approval.amount'},
            'status': {class: 'alwaysVisible w-min', title: 'status'},
            'actions': {class: 'actions alwaysVisible'},
        }) %}
        {{ tables.datatable_header('mileage_team', columns, null, {columnConfig: false, sticky: false, responsive: true}) }}
            {% for row in rows %}
                {% set user_param = row.user == app.user ? null : row.user.id %}
                <tr>
                    {% if bulk %}
                        <td class="{{ datatable_column_class('mileage_team', 'select') }}">{% if row.can_approve %}{{ kit.bulk_checkbox(bulk_form, row.lock.id) }}{% endif %}</td>
                    {% endif %}
                    <td class="{{ datatable_column_class('mileage_team', 'user') }}"><a href="{{ path('mileage_trips', {year: year, month: month, user: user_param}) }}">{{ row.user.displayName }}</a></td>
                    <td class="{{ datatable_column_class('mileage_team', 'trips') }} kpu-num">{{ row.trips|amount }}</td>
                    <td class="{{ datatable_column_class('mileage_team', 'business') }} kpu-num">{{ mileage.km(row.km.business, 0) }}</td>
                    <td class="{{ datatable_column_class('mileage_team', 'commute') }} kpu-num">{{ mileage.km(row.km.commute, 0) }}</td>
                    <td class="{{ datatable_column_class('mileage_team', 'private') }} kpu-num">{{ mileage.km(row.km.private, 0) }}</td>
                    <td class="{{ datatable_column_class('mileage_team', 'amount') }} kpu-num">{{ row.total|money('EUR') }}</td>
                    <td class="{{ datatable_column_class('mileage_team', 'status') }}">{{ mileage.month_status(row.lock) }}</td>
                    <td class="{{ datatable_column_class('mileage_team', 'actions') }}">
                        {% set event = actions(app.user, 'mileage_team_member', 'index', {lock_id: row.lock ? row.lock.id : null, can_approve: row.can_approve, year: year, month: month, user: user_param}) %}
                        {{ widgets.table_actions(event.actions) }}
                    </td>
                </tr>
            {% endfor %}
        {{ tables.data_table_footer(null, null, null) }}
        {% if bulk %}
            {{ kit.bulk_bar(bulk_form, [
                {label: 'mileage.approval.approve'|trans, url: path('mileage_team_approve'), token: csrf_token('mileage_team'), icon: 'success', ajax: true},
            ]) }}
        {% endif %}
    {% endif %}
{% endblock %}
