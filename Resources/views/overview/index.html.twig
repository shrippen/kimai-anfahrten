{% extends 'base.html.twig' %}

{% block page_content %}
    {% include '@Mileage/_nav.html.twig' with {active: 'overview'} %}
    <h2>{{ 'overview.title'|trans }} — {{ target_user.displayName }}</h2>
    <p class="text-muted">{{ 'overview.help'|trans }}</p>

    <form method="get" class="card mb-3">
        <input type="hidden" name="user" value="{{ target_user.id }}">
        <div class="card-body d-flex flex-wrap align-items-end gap-2">
            <div>
                <label class="form-label" for="ov-from">{{ 'suggestion.from'|trans }}</label>
                <input type="date" id="ov-from" name="from" class="form-control" value="{{ from|date('Y-m-d') }}">
            </div>
            <div>
                <label class="form-label" for="ov-to">{{ 'suggestion.to'|trans }}</label>
                <input type="date" id="ov-to" name="to" class="form-control" value="{{ to|date('Y-m-d') }}">
            </div>
            <div>
                <label class="form-label" for="ov-customer">{{ 'place.customer'|trans }}</label>
                <select id="ov-customer" name="customer" class="form-select">
                    <option value="0">{{ 'overview.all_customers'|trans }}</option>
                    {% for id, name in customers %}<option value="{{ id }}" {% if id == customer_id %}selected{% endif %}>{{ name }}</option>{% endfor %}
                </select>
            </div>
            <button type="submit" class="btn btn-primary">{{ 'overview.show'|trans }}</button>
            <a class="btn btn-outline-success" href="{{ path('mileage_overview', {user: target_user.id, from: from|date('Y-m-d'), to: to|date('Y-m-d'), customer: customer_id, format: 'csv'}) }}">CSV</a>
        </div>
    </form>

    {% for group in groups %}
        <div class="card mb-3">
            <div class="card-header d-flex">
                <h3 class="card-title me-auto">{{ group.name }}</h3>
                <span class="text-muted">{{ group.trips|length }} {{ 'tax.trips'|trans }} · {{ group.km|number_format(1, ',', '.') }} km · {{ group.costs|number_format(2, ',', '.') }} €</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-vcenter mb-0">
                    <thead><tr><th>{{ 'trip.date'|trans }}</th><th>{{ 'trip.project'|trans }}</th><th>{{ 'trip.route'|trans }}</th><th class="text-end">km</th><th class="text-end">{{ 'trip.costs'|trans }}</th><th>{{ 'trip.comment'|trans }}</th></tr></thead>
                    <tbody>
                        {% for row in group.trips %}
                            {% set t = row.trip %}
                            <tr>
                                <td class="text-nowrap">{{ t.date|date('Y-m-d') }}</td>
                                <td>{{ t.project ? t.project.name : '' }}</td>
                                <td>{{ t.startLocation|default('–') }} → {{ t.destination|default('–') }}</td>
                                <td class="text-end">{{ t.totalDistanceKm|number_format(1, ',', '.') }}</td>
                                <td class="text-end">{{ row.costs > 0 ? row.costs|number_format(2, ',', '.') ~ ' €' : '' }}</td>
                                <td>{{ t.comment }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">{{ 'overview.empty'|trans }}</div>
    {% endfor %}
{% endblock %}
