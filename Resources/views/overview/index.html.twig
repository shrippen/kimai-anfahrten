{% extends 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% import 'macros/datatables.html.twig' as tables %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, customer ? customer.name : 'mileage.overview.all_customers'|trans, 'mileage.overview.help'|trans]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    {{ form_start(filter) }}
        {{ form_widget(filter.daterange) }}
        {{ form_widget(filter.customer) }}
        <noscript><button type="submit" class="btn">{{ 'mileage.overview.show'|trans }}</button></noscript>
    {{ form_end(filter) }}
{% endblock %}

{% block main %}
    {% if groups is empty %}
        {{ kit.empty_state('mileage.overview.empty'|trans, customer ? path('mileage_overview', {from: from|date('Y-m-d'), to: to|date('Y-m-d')}) : null, customer ? 'mileage.overview.all_customers'|trans : null) }}
    {% else %}
        {{ kit.kpi_bar([
            {label: 'mileage.tax.trips'|trans, value: totals.trips|amount},
            {label: 'mileage.trip.total_distance'|trans, value: mileage.km(totals.km)},
            {label: 'mileage.trip.costs'|trans, value: totals.costs|money('EUR'), highlight: true},
            {label: 'mileage.overview.customers'|trans, value: groups|length|amount},
        ]) }}

        {% set columns = {
            'date': {class: 'alwaysVisible w-min', title: 'mileage.trip.date'},
            'project': {class: 'd-none d-md-table-cell', title: 'mileage.trip.project'},
            'route': {class: 'alwaysVisible', title: 'mileage.trip.route'},
            'distance': {class: 'text-end w-min text-nowrap', title: 'mileage.trip.distance_short'},
            'costs': {class: 'd-none d-sm-table-cell text-end w-min text-nowrap', title: 'mileage.trip.costs'},
            'comment': {class: 'd-none d-lg-table-cell', title: 'mileage.trip.comment'},
        } %}
        {% for group in groups %}
            <div class="card mb-3">
                {{ kit.group_header(
                    group.name,
                    group.customer ? group.customer.color|colorize(group.customer.name) : null,
                    ['mileage.tax.trip_count'|trans({'%count%': group.trips|length}), mileage.km(group.km), group.costs|money('EUR')],
                    null
                ) }}
                {{ tables.datatable_header('mileage_overview', columns, null, {columnConfig: false, sticky: false, boxClass: 'kpu-table-wrap'}) }}
                    {% for row in group.trips %}
                        {% set t = row.trip %}
                        <tr>
                            <td class="{{ datatable_column_class('mileage_overview', 'date') }} text-nowrap kpu-num">{{ t.date|date_short }}</td>
                            <td class="{{ datatable_column_class('mileage_overview', 'project') }}">{{ t.project ? t.project.name : '' }}</td>
                            <td class="{{ datatable_column_class('mileage_overview', 'route') }}">{{ t.startLocation|default('–') }} → {{ t.destination|default('–') }}</td>
                            <td class="{{ datatable_column_class('mileage_overview', 'distance') }} kpu-num">{{ mileage.km(t.totalDistanceKm) }}</td>
                            <td class="{{ datatable_column_class('mileage_overview', 'costs') }} kpu-num">{{ row.costs > 0 ? row.costs|money('EUR') : '' }}</td>
                            <td class="{{ datatable_column_class('mileage_overview', 'comment') }}">{{ t.comment }}</td>
                        </tr>
                    {% endfor %}
                {{ tables.data_table_footer(null, null, null) }}
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}
