{# Leaflet map. Params: map_id, track_url (optional JSON {points: [[lat, lon], ...]}), markers (optional [[lat, lon, label], ...]) #}
<div id="{{ map_id }}" class="mileage-map rounded border" style="height: 320px"
     data-track-url="{{ track_url|default('') }}"
     data-markers="{{ markers|default([])|json_encode }}"
     data-tiles="{{ mileage_map_tiles() }}"
     data-attribution="{{ mileage_map_attribution() }}"
     data-empty="{{ 'mileage.trip.map_empty'|trans }}"></div>
