{% extends 'base.html.twig' %}

{% block page_content %}
    {% include '@Mileage/_nav.html.twig' with {active: 'history'} %}
    <h2>{{ 'logbook.history'|trans }} — {{ target_user.displayName }}{% if trip_id %} — #{{ trip_id }}{% endif %}</h2>
    <p class="text-muted">{{ 'logbook.history_help'|trans }}</p>
    <div class="card">
        <div class="card-body p-0 table-responsive">
            <table class="table table-sm table-vcenter mb-0">
                <thead><tr><th>{{ 'logbook.changed_at'|trans }}</th><th>{{ 'trip.label'|trans }}</th><th>{{ 'logbook.action'|trans }}</th><th>{{ 'logbook.changed_by'|trans }}</th><th>{{ 'logbook.changes'|trans }}</th></tr></thead>
                <tbody>
                    {% for e in entries %}
                        <tr>
                            <td class="text-nowrap">{{ e.changedAt|date('Y-m-d H:i') }}{% if e.lockedMonth %} <i class="fas fa-lock text-warning" title="{{ 'logbook.month_locked'|trans }}"></i>{% endif %}</td>
                            <td><a href="{{ path('mileage_history', {user: target_user.id, trip: e.tripId}) }}">#{{ e.tripId }}</a></td>
                            <td>{{ ('logbook.action.' ~ e.action)|trans }}</td>
                            <td>{{ e.changedBy ? e.changedBy.displayName : '–' }}</td>
                            <td class="small">
                                {% for field, change in e.changes %}
                                    <div><strong>{{ field }}</strong>: {% if e.action == 'update' %}<del class="text-muted">{{ change[0] is same as(true) ? '✓' : (change[0] is same as(false) ? '✗' : change[0]) }}</del> → {% endif %}{{ change[1] is same as(true) ? '✓' : (change[1] is same as(false) ? '✗' : change[1]) }}</div>
                                {% endfor %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-muted">{{ 'logbook.history_empty'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
