{% extends 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% import 'macros/datatables.html.twig' as tables %}
{% import 'macros/widgets.html.twig' as widgets %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, 'mileage.logbook.months_help'|trans]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    {{ kit.period_nav(['year'], 'year', year, period.prev, period.next, period.today, {}) }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% set columns = {
        'month': {class: 'alwaysVisible', title: 'mileage.logbook.month'},
        'trips': {class: 'text-end w-min', title: 'mileage.tax.trips'},
        'status': {class: 'alwaysVisible w-min', title: 'status'},
        'details': {class: 'd-none d-md-table-cell', title: false},
        'actions': {class: 'actions alwaysVisible'},
    } %}
    {% set lock_title = approval_enabled ? 'mileage.approval.submit' : 'mileage.logbook.lock' %}
    {% set lock_question = (approval_enabled ? 'mileage.approval.submit_confirm' : 'mileage.logbook.lock_confirm')|trans %}
    {{ tables.datatable_header('mileage_months', columns, null, {columnConfig: false, sticky: false, responsive: true}) }}
        {% for m in 1..12 %}
            {% set lock = locks[m] ?? null %}
            {% set is_locked = lock is not null and lock.locked %}
            {% set month_date = date('%d-%02d-01'|format(year, m)) %}
            <tr>
                <td class="{{ datatable_column_class('mileage_months', 'month') }}">
                    <a href="{{ path('mileage_trips', {year: year, month: m, user: user_param}) }}">{{ month_date|month_name }}</a>
                </td>
                <td class="{{ datatable_column_class('mileage_months', 'trips') }} kpu-num">{{ counts[m]|amount }}</td>
                <td class="{{ datatable_column_class('mileage_months', 'status') }}">{{ mileage.month_status(lock) }}</td>
                <td class="{{ datatable_column_class('mileage_months', 'details') }} text-body-secondary small">
                    {% if lock %}
                        <div>{{ lock.status.label|trans }} · {{ lock.lockedAt|date_time }}{% if lock.lockedBy %} · {{ lock.lockedBy.displayName }}{% endif %}</div>
                        {% if lock.reviewedBy %}<div>{{ 'mileage.approval.reviewed_by'|trans }}: {{ lock.reviewedBy.displayName }}, {{ lock.reviewedAt|date_time }}</div>{% endif %}
                        {% if lock.comment %}<div class="text-danger">{{ lock.comment }}</div>{% endif %}
                    {% endif %}
                </td>
                <td class="{{ datatable_column_class('mileage_months', 'actions') }}">
                    {% set event = actions(app.user, 'mileage_month', 'index', {
                        year: year, month: m, user: user_param,
                        can_lock: can_lock and not is_locked,
                        can_unlock: can_unlock and lock is not null,
                        lock_title: lock_title,
                        lock_question: lock_question,
                    }) %}
                    {{ widgets.table_actions(event.actions) }}
                </td>
            </tr>
        {% endfor %}
    {{ tables.data_table_footer(null, null, null) }}
{% endblock %}
