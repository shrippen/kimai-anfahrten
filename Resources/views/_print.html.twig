{#
    Print view (logbook, tax report) and source of the tax PDF: a standalone, print-optimised page outside Kimai's
    layout (kimai-plugin-ui GUIDELINES do not apply to PDFs). Values use Kimai's formatters like the pages.
    Child templates fill "print_header" and "main".
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block print_title %}{{ 'mileage.logbook.title'|trans }}{% endblock %}</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; font-size: 11px; margin: 1.5cm; color: #111; background: #fff; }
        h1 { font-size: 16px; margin: 0 0 4px; }
        h3, .card-title { font-size: 13px; margin: 16px 0 6px; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 12px; }
        th, td { border: 1px solid #999; padding: 3px 5px; vertical-align: top; text-align: left; }
        th { background: #eee; }
        .text-end { text-align: right; }
        .text-body-secondary, .small { color: #555; font-size: 10px; }
        .kpu-kpis { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
        .kpu-kpi { flex: 1 1 22%; border: 1px solid #ccc; padding: 4px 6px; }
        .kpu-kpi-value { font-size: 14px; font-weight: bold; }
        .subheader { text-transform: uppercase; font-size: 9px; color: #555; }
        .alert { border: 1px solid #c90; padding: 6px; margin-bottom: 8px; }
        .dropdown-menu, .alert-icon { display: none; }
        .card { margin-bottom: 12px; }
        .fw-bold { font-weight: bold; }
        .print-toolbar { margin-bottom: 12px; }
        @media print { .print-toolbar { display: none; } body { margin: 0; } }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% if not (pdf ?? false) %}<div class="print-toolbar"><button type="button" id="mileage-print">{{ 'mileage.logbook.print'|trans }}</button></div>{% endif %}
    {% block print_header %}{% endblock %}
    {% block main %}{% endblock %}
    <p class="small">{{ 'now'|date_time }} · Kimai MileageBundle</p>
    {% if not (pdf ?? false) %}
        <script>
            document.getElementById('mileage-print').addEventListener('click', function () { window.print(); });
        </script>
    {% endif %}
    {% block javascripts %}{% endblock %}
</body>
</html>
