<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'mileage.logbook.title'|trans }}</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; font-size: 11px; margin: 1.5cm; color: #111; }
        h2 { font-size: 16px; margin: 0 0 8px; }
        h3 { font-size: 13px; margin: 16px 0 6px; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 12px; }
        th, td { border: 1px solid #999; padding: 3px 5px; vertical-align: top; }
        th { background: #eee; text-align: left; }
        .text-end { text-align: right; }
        .text-muted, .small { color: #555; font-size: 10px; }
        .card, .card-body, .row, .col-6, .col-md-3, .col-lg-6 { display: block; }
        .row { display: flex; flex-wrap: wrap; gap: 8px; }
        .row > div { flex: 1 1 22%; border: 1px solid #ccc; padding: 4px 6px; }
        .fs-3 { font-size: 14px; font-weight: bold; }
        .alert { border: 1px solid #c90; padding: 6px; margin-bottom: 8px; }
        .no-print { margin-bottom: 12px; }
        @media print { .no-print { display: none; } body { margin: 0; } }
    </style>
</head>
<body>
    <div class="no-print"><button onclick="window.print()">{{ 'mileage.logbook.print'|trans }}</button></div>
    {% block page_content %}{% endblock %}
    <p class="small">{{ 'now'|date('Y-m-d H:i') }} · Kimai MileageBundle</p>
</body>
</html>
