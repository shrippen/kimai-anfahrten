{% extends 'datatable.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% import 'macros/widgets.html.twig' as widgets %}

{% set bulk_form = 'mileage-suggestions-bulk' %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, 'mileage.suggestion.help'|trans]) }}
    {{ parent() }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block datatable_column_value %}
    {% set s = entry %}
    {% set is_locked = locked[s.id] ?? false %}
    {% if column == 'select' %}
        {% if not is_locked %}{{ kit.bulk_checkbox(bulk_form, s.id) }}{% endif %}
    {% elseif column == 'date' %}
        <span class="text-nowrap kpu-num">{{ s.startAt|date_short }}</span>
        <div class="text-body-secondary small text-nowrap kpu-num">{{ s.startAt|time }}–{{ s.endAt|time }}</div>
    {% elseif column == 'route' %}
        <div>{% if s.startPlace %}<i class="{{ s.startPlace.type.icon }} fa-fw me-1" aria-hidden="true"></i>{% endif %}{{ s.startLabel }}</div>
        <div>→ {% if s.endPlace %}<i class="{{ s.endPlace.type.icon }} fa-fw me-1" aria-hidden="true"></i>{% endif %}{{ s.endLabel }}</div>
        <div class="d-md-none text-body-secondary small">{{ s.purpose.label|trans }}</div>
    {% elseif column == 'distance' %}
        <span class="kpu-num">{{ mileage.km(s.distanceKm) }}</span>
        {% if s.mode %}<div class="text-body-secondary small">{{ ('mileage.dawarich.mode.' ~ s.mode)|trans }}</div>{% endif %}
    {% elseif column == 'purpose' %}
        <i class="{{ s.purpose.icon }} fa-fw me-1" aria-hidden="true"></i>{{ s.purpose.label|trans }}
        <div class="text-body-secondary small">{{ (s.vehicle ?? default_vehicle).label|trans }}</div>
    {% elseif column == 'project' %}
        {{ s.project ? s.project.customer.name ~ ' / ' ~ s.project.name : '' }}
    {% elseif column == 'status' %}
        {{ kit.status_badge(is_locked ? 'locked' : 'open', is_locked ? 'mileage.logbook.month_locked'|trans : null) }}
    {% elseif column == 'actions' %}
        {% set event = actions(app.user, 'mileage_suggestion', 'index', {suggestion: s, can_edit: can_edit, locked: is_locked}) %}
        {{ widgets.table_actions(event.actions) }}
    {% endif %}
{% endblock %}

{% block main %}
    {% if not dataTable.hasResults() %}
        {% if not dawarich_configured %}
            {{ kit.empty_state(
                'mileage.dawarich.not_configured_hint'|trans,
                target_user == app.user ? path('user_profile_preferences', {username: app.user.userIdentifier}) : null,
                target_user == app.user ? 'mileage.dawarich.setup'|trans : null
            ) }}
        {% else %}
            {{ kit.empty_state(
                'mileage.suggestion.empty'|trans,
                can_edit ? path('mileage_suggestions_detect', {user: user_param}) : null,
                can_edit ? 'mileage.suggestion.detect'|trans : null,
                'modal-ajax-form'
            ) }}
        {% endif %}
    {% else %}
        {{ parent() }}
        {% if bulk %}
            {{ kit.bulk_bar(bulk_form, [
                {label: 'mileage.suggestion.accept'|trans, url: path('mileage_suggestions_accept'), token: csrf_token('mileage_suggestions'), icon: 'success', ajax: true},
                {label: 'mileage.suggestion.dismiss'|trans, url: path('mileage_suggestions_dismiss'), token: csrf_token('mileage_suggestions'), icon: 'rejected', class: '', ajax: true},
            ]) }}
        {% endif %}
    {% endif %}
{% endblock %}
