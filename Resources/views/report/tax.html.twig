{% extends print ? '@Mileage/_print.html.twig' : 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% from '@theme/components/alert.html.twig' import alert %}

{% set self_employed = profile.value == 'self_employed' %}
{% set p = self_employed ? 'mileage.tax.se.' : 'mileage.tax.emp.' %}

{% macro day(value) -%}
    {%- if value|length == 7 %}{{ date(value ~ '-01')|month_name(true) }}{% else %}{{ value|date_short }}{% endif -%}
{%- endmacro %}

{% macro section(title, hint) -%}
    <div class="card-header">
        <div class="text-break">
            <h3 class="card-title">{{ title }}</h3>
            {% if hint %}<div class="card-subtitle text-body-secondary small mt-1 mb-0">{{ hint }}</div>{% endif %}
        </div>
    </div>
{%- endmacro %}

{% block stylesheets %}{{ parent() }}{% if not print %}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endif %}{% endblock %}
{% block javascripts %}{{ parent() }}{% if not print %}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endif %}{% endblock %}

{% block print_title %}{{ 'mileage.menu.tax'|trans }} · {{ year }}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, profile.label|trans, 'mileage.tax.trip_count'|trans({'%count%': trip_count})]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    {{ kit.period_nav(['year'], 'year', year, period.prev, period.next, period.today, {}) }}
{% endblock %}

{% block print_header %}
    <h1>{{ 'mileage.menu.tax'|trans }} · {{ year }}</h1>
    <p>{{ target_user.displayName }} · {{ profile.label|trans }}</p>
{% endblock %}

{% block main %}
    {% set c = summary.commute %}
    {% set meals = summary.meals %}
    {{ kit.kpi_bar([
        {label: (p ~ 'commute')|trans, value: c.amount|money('EUR'), hint: 'mileage.tax.commute_days_count'|trans({'%count%': c.days})},
        {label: (p ~ 'business')|trans, value: summary.business_total|money('EUR')},
        {label: 'mileage.meal.title'|trans, value: meals.amount|money('EUR')},
        {label: (p ~ 'total')|trans, value: summary.total|money('EUR'), highlight: true},
    ]) }}

    {{ alert({type: 'warning', description: 'mileage.tax.disclaimer'|trans, icon: 'warning', dismissible: false, important: false}) }}

    {% if findings|length > 0 %}
        <div class="card mb-3">
            {{ _self.section('mileage.plausibility.title'|trans, null) }}
            <div class="list-group list-group-flush">
                {% for f in findings %}
                    <div class="list-group-item">
                        {% if f.level == 'info' %}
                            <span class="text-body-secondary me-1">{{ icon('info', true) }}</span>
                        {% else %}
                            {{ kit.status_badge('warning', ('mileage.plausibility.level.' ~ f.level)|trans) }}
                        {% endif %}
                        {{ f.key|trans({'%count%': f.count}) }}
                        {% if f.dates|length > 0 %}
                            <div class="small text-body-secondary">{{ f.dates|map(d => _self.day(d))|join(', ') }}{% if f.count > f.dates|length %} …{% endif %}</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="card mb-3">
        {{ _self.section((p ~ 'commute')|trans, (p ~ 'commute_hint')|trans) }}
        <div class="table-responsive">
            <table class="table card-table table-vcenter mb-0">
                <tbody>
                    <tr><td>{{ 'mileage.tax.commute_days'|trans }}</td><td class="text-end">{{ c.days|amount }}</td></tr>
                    <tr><td>{{ 'mileage.tax.commute_km'|trans }}</td><td class="text-end">{{ mileage.km(c.km, 0) }}</td></tr>
                    <tr>
                        <td>{{ 'mileage.tax.rate'|trans }}</td>
                        <td class="text-end">
                            {% if c.rate == c.rate_from21 %}
                                {{ 'mileage.unit.per_km'|trans({'%amount%': c.rate|money('EUR')}) }}
                            {% else %}
                                {{ 'mileage.tax.rate_split'|trans({'%first%': c.rate|money('EUR'), '%from21%': c.rate_from21|money('EUR')}) }}
                            {% endif %}
                        </td>
                    </tr>
                    <tr><td>{{ 'mileage.tax.commute_car'|trans }}</td><td class="text-end">{{ c.amount_car|money('EUR') }}</td></tr>
                    <tr>
                        <td>
                            {{ 'mileage.tax.commute_other'|trans }}
                            {% if c.capped %}{{ kit.status_badge('warning', 'mileage.tax.capped'|trans({'%cap%': c.cap|money('EUR')})) }}{% endif %}
                            {% if c.public_transport_costs > 0 %}<div class="small text-body-secondary">{{ 'mileage.tax.public_transport_costs'|trans }}: {{ c.public_transport_costs|money('EUR') }}</div>{% endif %}
                        </td>
                        <td class="text-end">{{ c.amount_other_capped|money('EUR') }}</td>
                    </tr>
                    <tr class="fw-bold"><td>{{ 'mileage.tax.commute_total'|trans }}</td><td class="text-end">{{ c.amount|money('EUR') }}</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        {{ _self.section((p ~ 'business')|trans, (p ~ 'business_hint')|trans) }}
        <div class="table-responsive">
            <table class="table card-table table-vcenter mb-0">
                <thead>
                    <tr>
                        <th>{{ 'mileage.trip.vehicle'|trans }}</th>
                        <th class="text-end d-none d-sm-table-cell">{{ 'mileage.tax.trips'|trans }}</th>
                        <th class="text-end">{{ 'mileage.trip.distance_short'|trans }}</th>
                        <th class="text-end d-none d-md-table-cell">{{ 'mileage.tax.rate'|trans }}</th>
                        <th class="text-end d-none d-md-table-cell">{{ 'mileage.trip.costs'|trans }}</th>
                        <th class="text-end">{{ 'mileage.tax.deductible'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in summary.business %}
                        <tr>
                            <td>
                                {{ row.vehicle.label|trans }}{% if row.business_asset %} · {{ 'mileage.vehicle.business_asset'|trans }}{% endif %}
                                <div class="small text-body-secondary">
                                    {% if row.business_asset %}{{ 'mileage.tax.method.business_asset'|trans }}
                                    {% elseif row.vehicle.employerProvided and not self_employed %}{{ 'mileage.tax.method.employer'|trans }}
                                    {% elseif row.rate is not null %}{{ 'mileage.tax.method.km'|trans }}
                                    {% else %}{{ 'mileage.tax.method.costs'|trans }}{% endif %}
                                </div>
                            </td>
                            <td class="text-end d-none d-sm-table-cell">{{ row.trips|amount }}</td>
                            <td class="text-end text-nowrap">{{ mileage.km(row.km) }}</td>
                            <td class="text-end d-none d-md-table-cell text-nowrap">{{ row.rate is not null ? 'mileage.unit.per_km'|trans({'%amount%': row.rate|money('EUR')}) : '–' }}</td>
                            <td class="text-end d-none d-md-table-cell">{{ row.costs|money('EUR') }}</td>
                            <td class="text-end">{{ row.amount|money('EUR') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-body-secondary">{{ 'mileage.tax.no_business'|trans }}</td></tr>
                    {% endfor %}
                    <tr class="fw-bold"><td colspan="2">{{ 'mileage.tax.business_total'|trans }}</td><td class="d-none d-sm-table-cell"></td><td colspan="2" class="d-none d-md-table-cell"></td><td class="text-end">{{ summary.business_total|money('EUR') }}</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        {{ _self.section('mileage.meal.title'|trans, (p ~ 'meal_hint')|trans) }}
        <div class="card-body">
            <p class="mb-2">
                {{ 'mileage.meal.partial_days'|trans({'%count%': meals.partial_days, '%rate%': summary.rates.mealPartial|money('EUR')}) }} ·
                {{ 'mileage.meal.full_days'|trans({'%count%': meals.full_days, '%rate%': summary.rates.mealFull|money('EUR')}) }}
                {% if meals.excluded_days > 0 %} · {{ 'mileage.meal.excluded_days'|trans({'%count%': meals.excluded_days}) }}{% endif %}
                — <strong>{{ meals.amount|money('EUR') }}</strong>
            </p>
            {% if meals.missing_times > 0 %}
                <p class="mb-2">{{ kit.status_badge('warning', 'mileage.meal.missing_times'|trans({'%count%': meals.missing_times})) }} {{ 'mileage.meal.missing_times'|trans({'%count%': meals.missing_times}) }}</p>
            {% endif %}
            {% if meals.hint_home_work %}
                {{ alert({type: 'info', description: 'mileage.meal.hint_home_work'|trans, icon: 'info', dismissible: false, important: false}) }}
            {% endif %}
            {% if meals.review|length > 0 %}
                <p class="mb-1">{{ kit.status_badge('warning', 'mileage.meal.review_hint'|trans) }} <strong>{{ 'mileage.meal.review'|trans }}:</strong> {{ 'mileage.meal.review_hint'|trans }}</p>
                <ul class="mb-2">
                    {% for r in meals.review %}
                        <li>{{ r.date|date_short }}{% if r.destination %} · {{ r.destination }}{% endif %} — {{ ('mileage.meal.review.' ~ r.reason)|trans }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if meals.days|length > 0 %}
                <details {% if print %}open{% endif %}>
                    <summary>{{ 'mileage.meal.details'|trans }}</summary>
                    <div class="table-responsive">
                        <table class="table table-sm mt-2 mb-0">
                            <thead><tr><th>{{ 'mileage.trip.date'|trans }}</th><th>{{ 'mileage.meal.kind'|trans }}</th><th class="text-end d-none d-sm-table-cell">{{ 'mileage.commute.hours'|trans }}</th><th class="d-none d-md-table-cell">{{ 'mileage.trip.destination'|trans }}</th><th class="text-end">{{ 'mileage.meal.amount'|trans }}</th></tr></thead>
                            <tbody>
                                {% for d in meals.days %}
                                    <tr class="{{ d.three_month ? 'text-body-secondary' : '' }}">
                                        <td class="text-nowrap">{{ d.date|date_short }}</td>
                                        <td>{{ ('mileage.meal.kind.' ~ d.kind)|trans }}{% if d.three_month %} ({{ 'mileage.meal.three_month'|trans }}){% endif %}{% if d.overnight %}<div class="text-body-secondary small">{{ ('mileage.meal.overnight.' ~ d.overnight)|trans }}</div>{% endif %}</td>
                                        <td class="text-end d-none d-sm-table-cell">{{ d.kind == 'absence' ? (d.hours * 3600)|round|duration : '' }}</td>
                                        <td class="d-none d-md-table-cell">{{ d.destination }}</td>
                                        <td class="text-end">{{ d.amount|money('EUR') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </details>
            {% endif %}
        </div>
    </div>

    {% if self_employed and summary.private_use|length > 0 %}
        <div class="card mb-3">
            {{ _self.section('mileage.tax.se.private_use'|trans, 'mileage.tax.se.private_use_hint'|trans) }}
            <div class="table-responsive">
                <table class="table card-table table-vcenter mb-0">
                    <thead><tr><th>{{ 'mileage.trip.vehicle'|trans }}</th><th class="d-none d-md-table-cell">{{ 'mileage.vehicle.private_use'|trans }}</th><th class="text-end d-none d-sm-table-cell">{{ 'mileage.tax.months'|trans }}</th><th class="text-end d-none d-md-table-cell">{{ 'mileage.logbook.km.private'|trans }}</th><th class="text-end d-none d-lg-table-cell">{{ 'mileage.tax.private_share'|trans }}</th><th class="text-end">{{ 'mileage.tax.se.withdrawal'|trans }}</th><th class="text-end d-none d-sm-table-cell">{{ 'mileage.tax.se.commute_addition'|trans }}</th></tr></thead>
                    <tbody>
                        {% for u in summary.private_use %}
                            <tr>
                                <td>{{ u.vehicle.label }}</td>
                                <td class="d-none d-md-table-cell">{{ u.method.label|trans }}</td>
                                <td class="text-end d-none d-sm-table-cell">{{ u.months|amount }}</td>
                                <td class="text-end d-none d-md-table-cell text-nowrap">{{ mileage.km(u.km.private, 0) }}</td>
                                <td class="text-end d-none d-lg-table-cell">{{ 'mileage.logbook.share'|trans({'%share%': u.private_share|round(2)|amount}) }}</td>
                                <td class="text-end">{{ u.one_percent is not null ? u.one_percent|money('EUR') : '–' }}</td>
                                <td class="text-end d-none d-sm-table-cell">{{ u.commute_addition is not null ? u.commute_addition|money('EUR') : '–' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer small text-body-secondary">{{ 'mileage.tax.se.private_use_footer'|trans }}</div>
        </div>
    {% endif %}

    <div class="card mb-3">
        <div class="card-body">
            {{ 'mileage.trip.purpose.private'|trans }}: {{ 'mileage.tax.trip_count'|trans({'%count%': summary.private.trips}) }}, {{ mileage.km(summary.private.km) }}
            <div class="small text-body-secondary">{{ 'mileage.tax.private_hint'|trans }}</div>
        </div>
    </div>
{% endblock %}
