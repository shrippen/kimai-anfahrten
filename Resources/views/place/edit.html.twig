{% extends 'base.html.twig' %}

{% block page_content %}
    {% include '@Mileage/_nav.html.twig' with {active: 'places'} %}
    <h2>{{ (place.id ? 'mileage.place.edit' : 'mileage.place.create')|trans }} — {{ target_user.displayName }}</h2>
    <p><a href="{{ path('mileage_places', {user: target_user.id}) }}" class="btn btn-sm btn-link">&laquo; {{ 'mileage.place.list'|trans }}</a></p>
    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-3">
                <div class="card-body">
                    {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <button type="submit" class="btn btn-primary">{{ 'action.save'|trans }}</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            {% if mileage_map_enabled() %}{% include '@Mileage/_map.html.twig' with {map_id: 'place-map', markers: place.latitude or place.longitude ? [[place.latitude, place.longitude, place.name]] : []} %}{% endif %}
            <div class="form-text">{{ 'mileage.place.map_help'|trans }}</div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include '@Mileage/_map_script.html.twig' %}
{% endblock %}
