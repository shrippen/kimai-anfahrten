{% extends 'datatable.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}

{% set show_map = places is not empty and mileage_map_enabled() %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% include '@Mileage/_assets.html.twig' with {part: 'js'} %}
    {% if show_map %}{% include '@Mileage/_map_script.html.twig' %}{% endif %}
{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, 'mileage.place.help'|trans]) }}
    {{ parent() }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block datatable_row_attr %}
    {%- if can_edit %} class="modal-ajax-form open-edit" data-href="{{ path('mileage_place_edit', {id: entry.id}) }}"{% endif -%}
{% endblock %}

{% block datatable_column_value %}
    {% set p = entry %}
    {% if column == 'name' %}
        {{ p.name }}
        {% if p.dawarichAreaId or p.dawarichPlaceId %}<div class="text-body-secondary small">{{ 'mileage.place.from_dawarich'|trans }}</div>{% endif %}
        {% if p.temporary %}<div class="text-body-secondary small">{{ 'mileage.place.temporary'|trans }}</div>{% endif %}
    {% elseif column == 'type' %}
        <i class="{{ p.type.icon }} fa-fw me-1" aria-hidden="true"></i>{{ p.type.label|trans }}
    {% elseif column == 'address' %}
        {{ p.address }}
    {% elseif column == 'radius' %}
        {{ 'mileage.unit.m'|trans({'%m%': p.radius|amount}) }}
    {% elseif column == 'customer' %}
        {{ p.customer ? p.customer.name : '' }}
    {% elseif column == 'actions' %}
        {% set event = actions(app.user, 'mileage_place', 'index', {place: p, can_edit: can_edit}) %}
        {{ widgets.table_actions(event.actions) }}
    {% endif %}
{% endblock %}

{% block main %}
    {% if not dataTable.hasResults() %}
        {{ kit.empty_state(
            'mileage.place.empty'|trans,
            can_edit ? path('mileage_place_create', {user: user_param}) : null,
            can_edit ? 'mileage.place.create'|trans : null,
            'modal-ajax-form'
        ) }}
    {% else %}
        {% if show_map %}
            <div class="card mb-3">
                {% include '@Mileage/_map.html.twig' with {map_id: 'places-map', markers: places|map(p => [p.latitude, p.longitude, p.name]), map_class: 'card-img-top'} %}
            </div>
        {% endif %}
        {{ parent() }}
    {% endif %}
{% endblock %}
