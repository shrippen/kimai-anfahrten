{% extends 'base.html.twig' %}

{% set route_params = {user: target_user.id} %}

{% block page_content %}
    {% include '@Mileage/_nav.html.twig' with {active: 'trips'} %}
    {% set prev = month ? (month == 1 ? {year: year - 1, month: 12} : {year: year, month: month - 1}) : {year: year - 1} %}
    {% set next = month ? (month == 12 ? {year: year + 1, month: 1} : {year: year, month: month + 1}) : {year: year + 1} %}

    <div class="row mb-3">
        <div class="col-md-8">
            <h2>
                {{ 'mileage.menu'|trans }} — {{ target_user.displayName }} —
                {{ month ? '%d-%02d'|format(year, month) : year }}
            </h2>
            <p class="d-flex flex-wrap gap-1">
                <a href="{{ path('mileage_trips', prev|merge(route_params)) }}" class="btn btn-sm btn-outline-secondary">&laquo;</a>
                <a href="{{ path('mileage_trips', next|merge(route_params)) }}" class="btn btn-sm btn-outline-secondary">&raquo;</a>
                {% if month %}
                    <a href="{{ path('mileage_trips', {year: year}|merge(route_params)) }}" class="btn btn-sm btn-outline-secondary">{{ 'mileage.trip.whole_year'|trans }}</a>
                {% endif %}
                {% if can_edit %}
                    <a href="{{ path('mileage_trip_create', route_params) }}" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>{{ 'mileage.trip.create'|trans }}</a>
                    <a href="{{ path('mileage_trip_create', {purpose: 'commute'}|merge(route_params)) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-house-laptop me-1"></i>{{ 'mileage.trip.create_commute'|trans }}</a>
                    {% if month %}
                        <a href="{{ path('mileage_commutes', {year: year, month: month}|merge(route_params)) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-wand-magic-sparkles me-1"></i>{{ 'mileage.commute.generate'|trans }}</a>
                    {% endif %}
                {% endif %}
                {% if can_edit %}<a href="{{ path('mileage_import', route_params) }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-file-import me-1"></i>{{ 'mileage.import.title'|trans }}</a>{% endif %}
                <a href="{{ path('mileage_export', {year: year}|merge(route_params)) }}" class="btn btn-sm btn-outline-success">{{ 'action.export'|trans }} ({{ year }})</a>
            </p>
            {% if open_suggestions > 0 %}
                <div class="alert alert-info py-2"><a href="{{ path('mileage_suggestions', route_params) }}">{{ 'mileage.suggestion.open_hint'|trans({'%count%': open_suggestions}) }}</a></div>
            {% endif %}
            {% if month and locks[month] is defined and locks[month].locked %}
                <div class="alert alert-secondary py-2"><i class="fas fa-lock me-1"></i>{{ 'mileage.logbook.month_locked_hint'|trans }}</div>
            {% endif %}
            {% if not dawarich_configured %}
                <div class="alert alert-info py-2">{{ 'mileage.dawarich.not_configured_hint'|trans }}</div>
            {% elseif can_edit %}
                <form method="post" action="{{ path('mileage_dawarich_test', route_params) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('mileage_dawarich_test') }}">
                    <button type="submit" class="btn btn-sm btn-outline-info"><i class="fas fa-plug me-1"></i>{{ 'mileage.dawarich.test'|trans }}</button>
                </form>
            {% endif %}
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div>{{ 'mileage.trip.total_distance'|trans }}: <strong>{{ summary.total_km|number_format(1, ',', '.') }} km</strong></div>
                    {% set p = summary.profile.value == 'self_employed' ? 'mileage.tax.se.' : 'mileage.tax.emp.' %}
                    <div>{{ (p ~ 'commute')|trans }}: {{ summary.commute.days }} {{ 'mileage.tax.days'|trans }} · {{ summary.commute.amount|number_format(2, ',', '.') }} €</div>
                    <div>{{ (p ~ 'business')|trans }}: {{ summary.business_total|number_format(2, ',', '.') }} €</div>
                    {% if summary.meals.amount > 0 %}<div>{{ 'mileage.meal.title'|trans }}: {{ summary.meals.amount|number_format(2, ',', '.') }} €</div>{% endif %}
                    <div class="mt-1"><strong>{{ (p ~ 'total')|trans }}: {{ summary.total|number_format(2, ',', '.') }} €</strong></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0 table-responsive">
            <table class="table table-striped table-vcenter mb-0">
                <thead>
                    <tr>
                        <th>{{ 'mileage.trip.date'|trans }}</th>
                        <th>{{ 'mileage.trip.purpose'|trans }}</th>
                        <th>{{ 'mileage.trip.vehicle'|trans }}</th>
                        <th>{{ 'mileage.trip.route'|trans }}</th>
                        <th class="text-end">{{ 'mileage.trip.total_distance'|trans }}</th>
                        <th class="text-end">{{ 'mileage.trip.costs'|trans }}</th>
                        <th>{{ 'mileage.trip.project'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in trips %}
                        {% set locked = locks[t.date|date('n')] is defined and locks[t.date|date('n')].locked and t.date|date('Y') == year ~ '' %}
                        {% set changeable = not locked or edit_locked %}
                        <tr>
                            <td class="text-nowrap">
                                {{ t.date|date('Y-m-d') }}
                                {% if t.departureAt and t.arrivalAt %}
                                    <div class="small text-muted">{{ t.departureAt|date('H:i') }}–{{ t.arrivalAt|date('H:i') }}</div>
                                {% endif %}
                            </td>
                            <td><i class="{{ t.purpose.icon }} me-1"></i>{{ t.purpose.label|trans }}</td>
                            <td>
                                <i class="{{ t.vehicle.icon }} me-1"></i>{{ t.vehicle.label|trans }}
                                {% if t.licensePlate %}<div class="small text-muted">{{ t.licensePlate }}</div>{% endif %}
                            </td>
                            <td>
                                {{ t.startLocation|default('–') }} → {{ t.destination|default('–') }}
                                {% if t.comment %}<div class="small text-muted">{{ t.comment }}</div>{% endif %}
                            </td>
                            <td class="text-end text-nowrap">
                                {{ t.totalDistanceKm|number_format(1, ',', '.') }} km
                                {% if t.source.value == 'dawarich' %}
                                    <i class="fas fa-satellite-dish text-info ms-1" title="{{ 'mileage.trip.source.dawarich'|trans }} ({{ t.pointCount }})"></i>
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">{{ t.costs is not null ? t.costs|number_format(2, ',', '.') ~ ' €' : '' }}</td>
                            <td>{{ t.project ? t.project.name : '' }}</td>
                            <td class="text-end text-nowrap">
                                {% if locked %}<i class="fas fa-lock text-muted me-1" title="{{ 'mileage.logbook.month_locked'|trans }}"></i>{% endif %}
                                {% if can_edit and changeable %}
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('mileage_trip_edit', {id: t.id}) }}" title="{{ 'action.edit'|trans }}"><i class="fas fa-pen"></i></a>
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('mileage_trip_duplicate', {id: t.id}) }}" title="{{ 'action.duplicate'|trans }}"><i class="fas fa-copy"></i></a>
                                {% endif %}
                                {% if can_delete and changeable %}
                                    <form class="d-inline" method="post" action="{{ path('mileage_trip_delete', {id: t.id}) }}" onsubmit="return confirm('{{ 'confirm.delete'|trans|e('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('mileage_trip_delete' ~ t.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="{{ 'action.delete'|trans }}"><i class="fas fa-trash"></i></button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-muted">{{ 'mileage.trip.empty'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
