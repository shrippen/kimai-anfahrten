{% extends 'datatable.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% import 'macros/widgets.html.twig' as widgets %}
{% from '@theme/components/alert.html.twig' import alert %}

{% set p = summary.profile.value == 'self_employed' ? 'mileage.tax.se.' : 'mileage.tax.emp.' %}
{% set month_lock = month ? (locks[month] ?? null) : null %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {% set status %}{% if month %}{{ mileage.month_status(month_lock) }}{% endif %}{% endset %}
    {{ kit.context_line([target_user.displayName, summary.profile.label|trans, status]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    <div class="d-flex flex-wrap align-items-center gap-2">
        {{ kit.period_nav(['month', 'year'], period.unit, period.label, period.prev, period.next, period.today, period.units) }}
        {{ parent() }}
    </div>
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block datatable_column_value %}
    {% set t = entry %}
    {% set lock = locks[t.date|date('n')] ?? null %}
    {% set locked = lock is not null and lock.locked and t.date|date('Y') == year ~ '' %}
    {% if column == 'date' %}
        <span class="text-nowrap">{{ t.date|date_short }}</span>
        {% if t.departureAt and t.arrivalAt %}
            <div class="text-body-secondary small text-nowrap">{{ t.departureAt|time }}–{{ t.arrivalAt|time }}</div>
        {% endif %}
    {% elseif column == 'purpose' %}
        <i class="{{ t.purpose.icon }} fa-fw me-1" aria-hidden="true"></i>{{ t.purpose.label|trans }}
    {% elseif column == 'vehicle' %}
        <i class="{{ t.vehicle.icon }} fa-fw me-1" aria-hidden="true"></i>{{ t.vehicle.label|trans }}
        {% if t.licensePlate %}<div class="text-body-secondary small">{{ t.licensePlate }}</div>{% endif %}
    {% elseif column == 'route' %}
        <i class="{{ t.purpose.icon }} fa-fw me-1 d-md-none" title="{{ t.purpose.label|trans }}" aria-label="{{ t.purpose.label|trans }}"></i>
        {{ t.startLocation|default('–') }} → {{ t.destination|default('–') }}
        {% if t.comment %}<div class="text-body-secondary small">{{ t.comment }}</div>{% endif %}
    {% elseif column == 'distance' %}
        {{ mileage.km(t.totalDistanceKm) }}
        {% if t.source.value == 'dawarich' %}
            {% set source = 'mileage.trip.source.dawarich'|trans ~ ' · ' ~ 'mileage.trip.gps_points'|trans({'%count%': t.pointCount ?? 0}) %}
            <i class="fas fa-satellite-dish text-info ms-1" data-toggle="tooltip" title="{{ source }}" aria-label="{{ source }}"></i>
        {% endif %}
    {% elseif column == 'costs' %}
        {{ t.costs is not null ? t.costs|money('EUR') : '' }}
    {% elseif column == 'project' %}
        {{ t.project ? t.project.name : '' }}
    {% elseif column == 'status' %}
        {% if locked %}{{ mileage.month_status(lock) }}{% endif %}
    {% elseif column == 'actions' %}
        {% set event = actions(app.user, 'mileage_trip', 'index', {trip: t, can_edit: can_edit and (not locked or edit_locked), can_delete: can_delete and (not locked or edit_locked), receipts: can_edit and locked and not edit_locked}) %}
        {{ widgets.table_actions(event.actions) }}
    {% endif %}
{% endblock %}

{% block main %}
    {% if open_suggestions > 0 %}
        {% set hint %}{{ 'mileage.suggestion.open_hint'|trans({'%count%': open_suggestions}) }} <a class="alert-link" href="{{ path('mileage_suggestions', {user: user_param}) }}">{{ 'mileage.suggestion.review'|trans }}</a>{% endset %}
        {{ alert({type: 'info', description: hint, icon: 'info', dismissible: false, important: false, raw: true}) }}
    {% endif %}
    {% if month and month_lock is not null and month_lock.locked %}
        {{ alert({type: 'secondary', description: 'mileage.logbook.month_locked_hint'|trans, icon: 'locked', dismissible: false, important: false}) }}
    {% endif %}

    {% set details = [
        {label: 'mileage.logbook.km.business'|trans, value: mileage.km(km.business, 0)},
        {label: 'mileage.logbook.km.commute'|trans, value: mileage.km(km.commute, 0)},
        {label: 'mileage.logbook.km.private'|trans, value: mileage.km(km.private, 0)},
    ] %}
    {% set total_details = summary.meals.amount > 0 ? [{label: 'mileage.kpi.meals'|trans, value: summary.meals.amount|money('EUR')}] : [] %}
    {{ kit.kpi_bar([
        {label: 'mileage.trip.total_distance'|trans, value: mileage.km(summary.total_km, 0), details: details},
        {label: (p ~ 'commute')|trans, value: summary.commute.amount|money('EUR'), hint: 'mileage.tax.commute_days_count'|trans({'%count%': summary.commute.days})},
        {label: (p ~ 'business')|trans, value: summary.business_total|money('EUR')},
        {label: (p ~ 'total')|trans, value: summary.total|money('EUR'), highlight: true, details: total_details},
    ]) }}

    {% if not dataTable.hasResults() %}
        {{ kit.empty_state(
            (month ? 'mileage.trip.empty_period' : 'mileage.trip.empty_year')|trans({'%period%': period.label}),
            can_edit ? path('mileage_trip_create', {user: user_param, date: month ? '%d-%02d-01'|format(year, month) : null}) : null,
            can_edit ? 'mileage.trip.create'|trans : null
        ) }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
