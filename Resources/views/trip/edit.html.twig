{% extends 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% from '@theme/components/alert.html.twig' import alert %}

{% set show_map = trip.id and dawarich_configured and trip.departureAt and trip.arrivalAt and mileage_map_enabled() %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% include '@Mileage/_assets.html.twig' with {part: 'js'} %}
    {% if show_map %}{% include '@Mileage/_map_script.html.twig' %}{% endif %}
{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, trip.date ? trip.date|date_short : null]) }}
    {{ parent() }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% if read_only|default(false) %}
        {{ alert({type: 'warning', description: 'mileage.trip.locked_readonly'|trans, icon: 'locked', dismissible: false, important: false}) }}
    {% endif %}
    {% embed 'default/_form.html.twig' with {title: title|trans, form: form, back: back, reset: false, submit_button: 'action.save'} %}
        {% block form_body %}
            <div class="row">
                <div class="col-lg-6">
                    {{ form_row(form.date) }}
                    <div class="mb-3">
                        {{ form_label(form.purpose) }}
                        <div class="mt-1">
                            {% for child in form.purpose %}
                                <div class="form-check form-check-inline">
                                    <input type="radio" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" class="form-check-input" value="{{ child.vars.value }}" {% if child.vars.checked %}checked="checked"{% endif %} required="required">
                                    <label class="form-check-label" for="{{ child.vars.id }}"><i class="{{ child.vars.attr['data-icon']|default('') }} fa-fw me-1" aria-hidden="true"></i>{{ child.vars.label|trans }}</label>
                                </div>
                                {% do child.setRendered() %}
                            {% endfor %}
                        </div>
                        {{ form_help(form.purpose) }}
                        {{ form_errors(form.purpose) }}
                        {% do form.purpose.setRendered() %}
                    </div>
                    {% if form.assignedVehicle.vars.choices|length > 0 %}{{ form_row(form.assignedVehicle) }}{% else %}{% do form.assignedVehicle.setRendered() %}{% endif %}
                    <div class="row">
                        <div class="col-sm-7">{{ form_row(form.vehicle) }}</div>
                        <div class="col-sm-5">{{ form_row(form.licensePlate) }}</div>
                    </div>
                    {% if form.rental.vars.choices|length > 0 %}{{ form_row(form.rental) }}{% else %}{% do form.rental.setRendered() %}{% endif %}
                    <div class="row">
                        <div class="col-sm-6">{{ form_row(form.odometerStart) }}</div>
                        <div class="col-sm-6">{{ form_row(form.odometerEnd) }}</div>
                    </div>
                    {{ form_row(form.startLocation) }}
                    {{ form_row(form.destination) }}
                    {{ form_row(form.project) }}
                </div>
                <div class="col-lg-6">
                    <fieldset class="border rounded p-3 mb-3">
                        <legend class="form-label float-none w-auto px-1 mb-0">{{ 'mileage.trip.time_window'|trans }}</legend>
                        {{ form_row(form.departureAt) }}
                        {{ form_row(form.arrivalAt) }}
                    </fieldset>
                    <fieldset class="border rounded p-3 mb-3">
                        <legend class="form-label float-none w-auto px-1 mb-0">{{ 'mileage.dawarich.window'|trans }}</legend>
                        {% if form.dawarich is defined %}
                            <div class="row">
                                <div class="col-sm-6">{{ form_row(form.measureFrom) }}</div>
                                <div class="col-sm-6">{{ form_row(form.measureTo) }}</div>
                            </div>
                            {{ form_widget(form.dawarich) }}
                            <div class="form-text">{{ 'mileage.dawarich.lookup_help'|trans }}</div>
                        {% else %}
                            <div class="form-text">{{ 'mileage.dawarich.not_configured_hint'|trans }}</div>
                        {% endif %}
                    </fieldset>
                    {{ form_row(form.distanceKm) }}
                    {% if show_map %}
                        <div class="mb-3">
                            {% include '@Mileage/_map.html.twig' with {map_id: 'trip-map', track_url: path('mileage_trip_track', {id: trip.id})} %}
                        </div>
                    {% endif %}
                    {% if trip.source.value == 'dawarich' %}
                        <p class="small text-body-secondary"><i class="fas fa-satellite-dish text-info me-1" aria-hidden="true"></i>{{ 'mileage.trip.source.dawarich'|trans }} · {{ 'mileage.trip.gps_points'|trans({'%count%': trip.pointCount ?? 0}) }}</p>
                    {% endif %}
                    {{ form_row(form.roundTrip) }}
                    {{ form_row(form.overnight) }}
                    {{ form_row(form.costs) }}
                    {{ form_row(form.comment) }}
                </div>
            </div>
        {% endblock %}
        {% block submit_button %}
            {{ form_widget(form.save) }}
        {% endblock %}
    {% endembed %}

    {% if trip.id %}
        {% include '@Mileage/_attachments.html.twig' with {upload_url: path('mileage_attachment_trip', {id: trip.id})} %}
    {% endif %}
{% endblock %}
