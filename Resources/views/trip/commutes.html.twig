{% extends 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import 'macros/datatables.html.twig' as tables %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, period_label]) }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% embed 'default/_form.html.twig' with {title: 'mileage.commute.generate'|trans, form: form, back: back, reset: false, submit_button: 'mileage.commute.create'} %}
        {% import '@Mileage/_kit/macros.html.twig' as kit %}
        {% import 'macros/datatables.html.twig' as tables %}
        {% block form_body %}
            <p class="text-body-secondary">{{ 'mileage.commute.generate_help'|trans }}</p>
            {{ form_row(form.distance) }}
            {% if days is empty %}
                {{ kit.empty_state('mileage.commute.no_days'|trans) }}
                {% do form.dates.setRendered() %}
            {% else %}
                {{ form_label(form.dates) }}
                {% set columns = {
                    'select': {class: 'alwaysVisible w-min', title: false},
                    'date': {class: 'alwaysVisible', title: 'mileage.trip.date'},
                    'hours': {class: 'text-end w-min', title: 'mileage.commute.hours'},
                    'state': {class: 'd-none d-sm-table-cell', title: false},
                } %}
                {{ tables.datatable_header('mileage_commute_days', columns, null, {columnConfig: false, sticky: false, boxClass: 'kpu-table-wrap border rounded mb-3'}) }}
                    {% for child in form.dates %}
                        {% set day = days[child.vars.value] %}
                        <tr>
                            <td class="{{ datatable_column_class('mileage_commute_days', 'select') }} kpu-num">{{ form_widget(child, {label: false, attr: {class: 'form-check-input m-0', 'aria-label': day.date|date_short}}) }}</td>
                            <td class="{{ datatable_column_class('mileage_commute_days', 'date') }} kpu-num"><label for="{{ child.vars.id }}">{{ day.date|day_name(true) }}, {{ day.date|date_short }}</label></td>
                            <td class="{{ datatable_column_class('mileage_commute_days', 'hours') }} kpu-num">{{ (day.hours * 3600)|round|duration }}</td>
                            <td class="{{ datatable_column_class('mileage_commute_days', 'state') }} text-body-secondary">{% if day.has_commute %}{{ 'mileage.commute.already_recorded'|trans }}{% endif %}</td>
                        </tr>
                    {% endfor %}
                {{ tables.data_table_footer(null, null, null) }}
                {% do form.dates.setRendered() %}
            {% endif %}
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
