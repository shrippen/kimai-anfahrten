{% extends 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% import 'macros/datatables.html.twig' as tables %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName]) }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% embed 'default/_form.html.twig' with {title: 'mileage.import.title'|trans, form: upload_form, back: back, reset: false, submit_button: 'mileage.import.check'} %}
        {% block form_body %}
            <p class="text-body-secondary">{{ 'mileage.import.help'|trans }}</p>
            {{ form_widget(upload_form) }}
        {% endblock %}
    {% endembed %}

    {% if preview %}
        {% set ok = preview.rows|filter(r => r.trip and not r.duplicate)|length %}
        {% set dup = preview.rows|filter(r => r.duplicate)|length %}
        {% set bad = preview.rows|filter(r => not r.trip)|length %}
        {{ kit.kpi_bar([
            {label: 'mileage.import.kpi.ready'|trans, value: ok|amount, highlight: true},
            {label: 'mileage.import.kpi.duplicates'|trans, value: dup|amount},
            {label: 'mileage.import.kpi.errors'|trans, value: bad|amount},
        ]) }}

        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">{{ 'mileage.import.preview'|trans }}</h3>
            </div>
            <div class="card-body small">
                {{ 'mileage.import.recognized'|trans }}:
                {% for c in preview.columns %}<span class="badge {{ c ? 'bg-blue-lt' : 'bg-secondary-lt' }} me-1">{{ c ?: '–' }}</span>{% endfor %}
            </div>
            {% set columns = {
                'line': {class: 'w-min', title: 'mileage.import.line'},
                'date': {class: 'alwaysVisible w-min', title: 'mileage.trip.date'},
                'purpose': {class: 'd-none d-md-table-cell', title: 'mileage.trip.purpose'},
                'vehicle': {class: 'd-none d-lg-table-cell', title: 'mileage.trip.vehicle'},
                'route': {class: 'alwaysVisible', title: 'mileage.trip.route'},
                'distance': {class: 'text-end w-min text-nowrap', title: 'mileage.trip.distance_short'},
                'status': {class: 'w-min', title: 'status'},
            } %}
            {{ tables.datatable_header('mileage_import', columns, null, {columnConfig: false, sticky: false, boxClass: 'kpu-table-wrap'}) }}
                {% for r in preview.rows %}
                    <tr>
                        <td class="{{ datatable_column_class('mileage_import', 'line') }}">{{ r.line }}</td>
                        {% if r.trip %}
                            <td class="{{ datatable_column_class('mileage_import', 'date') }} text-nowrap">{{ r.trip.date|date_short }}</td>
                            <td class="{{ datatable_column_class('mileage_import', 'purpose') }}">{{ r.trip.purpose.label|trans }}</td>
                            <td class="{{ datatable_column_class('mileage_import', 'vehicle') }}">{{ r.trip.vehicle.label|trans }}</td>
                            <td class="{{ datatable_column_class('mileage_import', 'route') }}">{{ r.trip.startLocation|default('–') }} → {{ r.trip.destination|default('–') }}</td>
                            <td class="{{ datatable_column_class('mileage_import', 'distance') }}">{{ mileage.km(r.trip.totalDistanceKm) }}</td>
                            <td class="{{ datatable_column_class('mileage_import', 'status') }}">{% if r.duplicate %}{{ kit.status_badge('warning', 'mileage.import.duplicate'|trans) }}{% endif %}</td>
                        {% else %}
                            <td colspan="6" class="text-danger">
                                {% for field, error in r.errors %}<div><strong>{{ field }}</strong>: {{ error|trans }}</div>{% endfor %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            {{ tables.data_table_footer(null, null, null) }}
            {% if run_form and (ok > 0 or dup > 0) %}
                <div class="card-footer">
                    {{ form_start(run_form, {attr: {class: 'd-flex flex-wrap gap-3 align-items-center'}}) }}
                        {{ form_widget(run_form.skip_duplicates) }}
                        <button type="submit" class="btn btn-primary ms-auto">{{ 'mileage.import.run'|trans }}</button>
                    {{ form_end(run_form) }}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
