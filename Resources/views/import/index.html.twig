{% extends 'base.html.twig' %}

{% block page_content %}
    {% include '@Mileage/_nav.html.twig' with {active: 'trips'} %}
    <h2>{{ 'import.title'|trans }} — {{ target_user.displayName }}</h2>
    <p class="text-muted">{{ 'import.help'|trans }}</p>

    <form method="post" enctype="multipart/form-data" class="card mb-3" style="max-width: 48rem">
        <input type="hidden" name="_token" value="{{ csrf_token('mileage_import') }}">
        <input type="hidden" name="action" value="preview">
        <div class="card-body d-flex gap-2">
            <input type="file" name="file" class="form-control" accept=".csv,text/csv,text/plain" required>
            <button type="submit" class="btn btn-primary text-nowrap">{{ 'import.check'|trans }}</button>
        </div>
        <div class="card-footer small text-muted">{{ 'import.columns'|trans }}</div>
    </form>

    {% if preview %}
        {% set ok = preview.rows|filter(r => r.trip and not r.duplicate)|length %}
        {% set dup = preview.rows|filter(r => r.duplicate)|length %}
        {% set bad = preview.rows|filter(r => not r.trip)|length %}
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap gap-2 align-items-center">
                <h3 class="card-title me-auto">{{ 'import.preview'|trans }}</h3>
                <span class="badge bg-green text-white">{{ 'import.ok'|trans({'%count%': ok}) }}</span>
                <span class="badge bg-yellow">{{ 'import.duplicates'|trans({'%count%': dup}) }}</span>
                <span class="badge bg-red text-white">{{ 'import.errors'|trans({'%count%': bad}) }}</span>
            </div>
            <div class="card-body small">
                {{ 'import.recognized'|trans }}:
                {% for c in preview.columns %}<span class="badge {{ c ? 'bg-blue-lt' : 'bg-secondary-lt' }} me-1">{{ c ?: '–' }}</span>{% endfor %}
            </div>
            <div class="card-body p-0 table-responsive" style="max-height: 60vh">
                <table class="table table-sm table-vcenter mb-0">
                    <thead><tr><th>#</th><th>{{ 'trip.date'|trans }}</th><th>{{ 'trip.purpose'|trans }}</th><th>{{ 'trip.vehicle'|trans }}</th><th>{{ 'trip.route'|trans }}</th><th class="text-end">km</th><th></th></tr></thead>
                    <tbody>
                        {% for r in preview.rows %}
                            <tr class="{{ not r.trip ? 'table-danger' : (r.duplicate ? 'table-warning' : '') }}">
                                <td>{{ r.line }}</td>
                                {% if r.trip %}
                                    <td>{{ r.trip.date|date('Y-m-d') }}</td>
                                    <td>{{ r.trip.purpose.label|trans }}</td>
                                    <td>{{ r.trip.vehicle.label|trans }}</td>
                                    <td>{{ r.trip.startLocation|default('–') }} → {{ r.trip.destination|default('–') }}</td>
                                    <td class="text-end">{{ r.trip.totalDistanceKm|number_format(1, ',', '.') }}</td>
                                    <td>{{ r.duplicate ? 'import.duplicate'|trans : '' }}</td>
                                {% else %}
                                    <td colspan="6">{% for field, error in r.errors %}<div><strong>{{ field }}</strong>: {{ error|trans }}</div>{% endfor %}</td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if ok > 0 or dup > 0 %}
                <form method="post" class="card-footer d-flex gap-3 align-items-center">
                    <input type="hidden" name="_token" value="{{ csrf_token('mileage_import') }}">
                    <input type="hidden" name="content" value="{{ content }}">
                    <input type="hidden" name="action" value="import">
                    <input type="hidden" name="skip_duplicates" value="0">
                    <label class="form-check mb-0"><input type="checkbox" class="form-check-input" name="skip_duplicates" value="1" checked> {{ 'import.skip_duplicates'|trans }}</label>
                    <button type="submit" class="btn btn-success ms-auto">{{ 'import.run'|trans }}</button>
                </form>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
