{% extends 'datatable.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, 'mileage.vehicle.help'|trans]) }}
    {{ parent() }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block datatable_row_attr %}
    {%- if can_edit %} class="modal-ajax-form open-edit" data-href="{{ path('mileage_vehicle_edit', {id: entry.id}) }}"{% endif -%}
{% endblock %}

{% block datatable_column_value %}
    {% set v = entry %}
    {% if column == 'name' %}
        <i class="{{ v.type.icon }} fa-fw me-1 d-md-none" aria-hidden="true"></i>{{ v.name }}
        {% if v.licensePlate %}<div class="text-body-secondary small d-sm-none">{{ v.licensePlate }}</div>{% endif %}
    {% elseif column == 'type' %}
        <i class="{{ v.type.icon }} fa-fw me-1" aria-hidden="true"></i>{{ v.type.label|trans }}
    {% elseif column == 'plate' %}
        {{ v.licensePlate }}
    {% elseif column == 'period' %}
        <span class="kpu-num">{{ v.validFrom ? v.validFrom|date_short : '…' }} – {{ v.validTo ? v.validTo|date_short : '…' }}</span>
    {% elseif column == 'private_use' %}
        {{ v.businessAsset ? v.privateUse.label|trans : '–' }}
    {% elseif column == 'active' %}
        {{ widgets.label_boolean(v.active) }}
    {% elseif column == 'actions' %}
        {% set event = actions(app.user, 'mileage_vehicle', 'index', {vehicle: v, year: year, can_edit: can_edit, can_delete: can_delete}) %}
        {{ widgets.table_actions(event.actions) }}
    {% endif %}
{% endblock %}

{% block main %}
    {% if not dataTable.hasResults() %}
        {{ kit.empty_state(
            'mileage.vehicle.empty'|trans,
            can_edit ? path('mileage_vehicle_create', {user: user_param}) : null,
            can_edit ? 'mileage.vehicle.create'|trans : null,
            'modal-ajax-form'
        ) }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
