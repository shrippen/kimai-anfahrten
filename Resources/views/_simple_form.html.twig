{% extends 'base.html.twig' %}

{% block page_content %}
    {% include '@Mileage/_nav.html.twig' with {active: nav_active} %}
    <h2>{{ title|trans }} — {{ target_user.displayName }}</h2>
    <p><a href="{{ back_url }}" class="btn btn-sm btn-link">&laquo; {{ back_label|trans }}</a></p>
    <div class="card mb-3" style="max-width: 60rem">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary">{{ 'action.save'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
