{% extends 'base.html.twig' %}

{% block page_content %}
    {% include '@Mileage/_nav.html.twig' with {active: 'rentals'} %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h2 class="me-auto mb-0">{{ 'rental.label'|trans }}: {{ rental.provider }} — {{ rental.startDate|date('Y-m-d') }} – {{ rental.endDate|date('Y-m-d') }}</h2>
        <a href="{{ path('mileage_rentals', {year: rental.startDate|date('Y'), user: target_user.id}) }}" class="btn btn-sm btn-link">&laquo; {{ 'rental.list'|trans }}</a>
        {% if can_edit %}
            <a href="{{ path('mileage_rental_edit', {id: rental.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen me-1"></i>{{ 'action.edit'|trans }}</a>
            <form method="post" action="{{ path('mileage_rental_delete', {id: rental.id}) }}" onsubmit="return confirm('{{ 'confirm.delete'|trans|e('js') }}');">
                <input type="hidden" name="_token" value="{{ csrf_token('mileage_rental_delete' ~ rental.id) }}">
                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="fas fa-trash"></i></button>
            </form>
        {% endif %}
    </div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body p-0">
                    <table class="table table-vcenter mb-0">
                        <thead><tr><th>{{ 'trip.date'|trans }}</th><th>{{ 'trip.purpose'|trans }}</th><th>{{ 'trip.route'|trans }}</th><th class="text-end">km</th><th class="text-end">{{ 'rental.share'|trans }}</th></tr></thead>
                        <tbody>
                            {% set business = 0 %}
                            {% for t in trips %}
                                {% set share = allocation[t|mileage_object_id]|default(0) %}
                                {% if t.purpose.value == 'business' %}{% set business = business + share %}{% endif %}
                                <tr>
                                    <td><a href="{{ path('mileage_trip_edit', {id: t.id}) }}">{{ t.date|date('Y-m-d') }}</a></td>
                                    <td>{{ t.purpose.label|trans }}</td>
                                    <td>{{ t.startLocation|default('–') }} → {{ t.destination|default('–') }}</td>
                                    <td class="text-end">{{ t.totalDistanceKm|number_format(1, ',', '.') }}</td>
                                    <td class="text-end">{{ share|number_format(2, ',', '.') }} €</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-muted">{{ 'rental.no_trips'|trans }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <div>{{ 'rental.costs'|trans }}: {{ rental.rentalCosts|number_format(2, ',', '.') }} €</div>
                    <div>{{ 'rental.fuel_costs'|trans }}: {{ rental.fuelCosts|number_format(2, ',', '.') }} €</div>
                    <div class="fw-bold">{{ 'rental.total'|trans }}: {{ rental.totalCosts|number_format(2, ',', '.') }} €</div>
                    <div class="mt-2 text-success">{{ 'rental.business_share'|trans }}: {{ business|number_format(2, ',', '.') }} €</div>
                    {% if rental.comment %}<div class="text-muted small mt-2">{{ rental.comment }}</div>{% endif %}
                </div>
            </div>
            {% include '@Mileage/_attachments.html.twig' with {upload_url: path('mileage_attachment_rental', {id: rental.id}), can_delete: can_edit} %}
        </div>
    </div>
{% endblock %}
