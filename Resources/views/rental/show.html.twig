{% extends 'base.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import '@Mileage/_macros.html.twig' as mileage %}
{% import 'macros/datatables.html.twig' as tables %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, rental.startDate|date_short ~ ' – ' ~ rental.endDate|date_short, rental.licensePlate]) }}
    {{ parent() }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% set business = 0 %}
    {% for t in trips %}
        {% if t.purpose.value == 'business' %}{% set business = business + (allocation[t|mileage_object_id] ?? 0) %}{% endif %}
    {% endfor %}
    {{ kit.kpi_bar([
        {label: 'mileage.rental.costs'|trans, value: rental.rentalCosts|money('EUR')},
        {label: 'mileage.rental.fuel_costs'|trans, value: rental.fuelCosts|money('EUR')},
        {label: 'mileage.rental.total'|trans, value: rental.totalCosts|money('EUR')},
        {label: 'mileage.rental.business_share'|trans, value: business|money('EUR'), highlight: true},
    ]) }}

    {% if rental.comment %}
        <p class="text-body-secondary">{{ rental.comment }}</p>
    {% endif %}

    {% if trips is empty %}
        {{ kit.empty_state('mileage.rental.no_trips'|trans) }}
    {% else %}
        {% set columns = {
            'date': {class: 'alwaysVisible w-min', title: 'mileage.trip.date'},
            'purpose': {class: 'd-none d-sm-table-cell', title: 'mileage.trip.purpose'},
            'route': {class: 'alwaysVisible', title: 'mileage.trip.route'},
            'distance': {class: 'text-end w-min text-nowrap', title: 'mileage.trip.distance_short'},
            'share': {class: 'd-none d-md-table-cell text-end w-min text-nowrap', title: 'mileage.rental.share'},
        } %}
        {{ tables.datatable_header('mileage_rental_trips', columns, null, {columnConfig: false, sticky: false, responsive: true}) }}
            {% for t in trips %}
                <tr>
                    <td class="{{ datatable_column_class('mileage_rental_trips', 'date') }}"><a href="{{ path('mileage_trip_edit', {id: t.id}) }}">{{ t.date|date_short }}</a></td>
                    <td class="{{ datatable_column_class('mileage_rental_trips', 'purpose') }}">{{ t.purpose.label|trans }}</td>
                    <td class="{{ datatable_column_class('mileage_rental_trips', 'route') }}">{{ t.startLocation|default('–') }} → {{ t.destination|default('–') }}</td>
                    <td class="{{ datatable_column_class('mileage_rental_trips', 'distance') }}">{{ mileage.km(t.totalDistanceKm) }}</td>
                    <td class="{{ datatable_column_class('mileage_rental_trips', 'share') }}">{{ (allocation[t|mileage_object_id] ?? 0)|money('EUR') }}</td>
                </tr>
            {% endfor %}
        {{ tables.data_table_footer(null, null, null) }}
    {% endif %}

    {% include '@Mileage/_attachments.html.twig' with {can_delete: can_edit} %}
{% endblock %}
