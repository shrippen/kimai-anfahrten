{% extends 'datatable.html.twig' %}
{% import '@Mileage/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}

{% block stylesheets %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Mileage/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, 'mileage.rental.help'|trans]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    {{ kit.period_nav(['year'], 'year', year, period.prev, period.next, period.today, {}) }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block datatable_column_value %}
    {% set r = entry %}
    {% if column == 'provider' %}
        <a href="{{ path('mileage_rental_show', {id: r.id}) }}">{{ r.provider }}</a>
        <div class="text-body-secondary small d-sm-none">{{ r.startDate|date_short }} – {{ r.endDate|date_short }}</div>
    {% elseif column == 'period' %}
        {{ r.startDate|date_short }} – {{ r.endDate|date_short }}
    {% elseif column == 'plate' %}
        {{ r.licensePlate }}
    {% elseif column == 'total' %}
        {{ r.totalCosts|money('EUR') }}
    {% elseif column == 'actions' %}
        {% set event = actions(app.user, 'mileage_rental', 'index', {rental: r, can_edit: can_edit, can_delete: can_delete}) %}
        {{ widgets.table_actions(event.actions) }}
    {% endif %}
{% endblock %}

{% block main %}
    {% if not dataTable.hasResults() %}
        {{ kit.empty_state(
            'mileage.rental.empty_year'|trans({'%year%': year}),
            can_edit ? path('mileage_rental_create', {user: user_param}) : null,
            can_edit ? 'mileage.rental.create'|trans : null,
            'modal-ajax-form'
        ) }}
    {% else %}
        {{ kit.kpi_bar([
            {label: 'mileage.rental.count'|trans, value: dataTable.pagination.nbResults|amount},
            {label: 'mileage.rental.total'|trans, value: total|money('EUR'), highlight: true},
        ]) }}
        {{ parent() }}
    {% endif %}
{% endblock %}
